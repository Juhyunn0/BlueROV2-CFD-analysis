FoamFile
{
    format      ascii;
    class       volScalarField;
    object      omega;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

// omega = k^0.5/(Cmu^0.25 * l), l = 0.07*D = 0.021 m -> ~1.1 1/s
dimensions      [0 0 -1 0 0 0 0];

internalField   uniform 1.1;

boundaryField
{
    #includeEtc "caseDicts/setConstraintTypes"

    inlet
    {
        type            fixedValue;
        value           uniform 1.1;
    }

    outlet
    {
        type            inletOutlet;
        inletValue      uniform 1.1;
        value           uniform 1.1;
    }

    "side.*"
    {
        type            symmetry;
    }

    sphere
    {
        type            omegaWallFunction;
        value           uniform 1.1;
    }
}

