FoamFile
{
    format      ascii;
    class       volVectorField;
    object      U;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

// Oscillating inflow U(t) = U0 sin(2 pi t / T), U0 = 0.2 m/s, T = 1.0 s
dimensions      [0 1 -1 0 0 0 0];

internalField   uniform (0 0 0);

boundaryField
{
    #includeEtc "caseDicts/setConstraintTypes"

    inlet
    {
        type            uniformFixedValue;
        uniformValue
        {
            type            sine;
            amplitude       (0 0 0.2);
            frequency       1.0;
            start           0;
            level           (0 0 0);
        }
        value           uniform (0 0 0);
    }

    outlet
    {
        type            pressureInletOutletVelocity;
        value           uniform (0 0 0);
    }

    "side.*"
    {
        type            symmetry;
    }

    sphere
    {
        type            noSlip;
    }
}

