FoamFile
{
    format      binary;
    class       volScalarField;
    location    "0";
    object      omega;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

dimensions      [0 0 -1 0 0 0 0];

internalField   uniform 2.1;

boundaryField
{
    inlet
    {
        type            fixedValue;
        value           nonuniform List<scalar> 
0
;
    }
    outlet
    {
        type            inletOutlet;
        inletValue      nonuniform List<scalar> 
0
;
        value           nonuniform List<scalar> 
0
;
    }
    sideXMin
    {
        type            symmetry;
    }
    sideXMax
    {
        type            symmetry;
    }
    sideYMin
    {
        type            symmetry;
    }
    sideYMax
    {
        type            symmetry;
    }
    BROV2
    {
        type            omegaWallFunction;
        value           uniform 2.1;
    }
    procBoundary2to0
    {
        type            processor;
        value           uniform 2.1;
    }
    procBoundary2to1
    {
        type            processor;
        value           uniform 2.1;
    }
    procBoundary2to3
    {
        type            processor;
        value           uniform 2.1;
    }
    procBoundary2to6
    {
        type            processor;
        value           uniform 2.1;
    }
    procBoundary2to7
    {
        type            processor;
        value           uniform 2.1;
    }
}


