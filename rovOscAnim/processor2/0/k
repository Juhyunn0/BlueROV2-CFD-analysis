internalField   uniform 0.00015;

boundaryField
{
    xmin
    {
        type            zeroGradient;
    }
    xmax
    {
        type            zeroGradient;
    }
    ymin
    {
        type            zeroGradient;
    }
    ymax
    {
        type            zeroGradient;
    }
    zmin
    {
        type            fixedValue;
        value           nonuniform List<scalar> 
0
;
    }
    zmax
    {
        type            inletOutlet;
        inletValue      uniform 0.00015;
        value           uniform 0.00015;
    }
    BROV2
    {
        type            kqRWallFunction;
        value           nonuniform List<scalar> 
0
;
    }
    procBoundary2to0
    {
        type            processor;
        value           uniform 0.00015;
    }
    procBoundary2to1
    {
        type            processor;
        value           uniform 0.00015;
    }
    procBoundary2to3
    {
        type            processor;
        value           uniform 0.00015;
    }
    procBoundary2to4
    {
        type            processor;
        value           uniform 0.00015;
    }
    procBoundary2to6
    {
        type            processor;
        value           uniform 0.00015;
    }
    procBoundary2to7
    {
        type            processor;
        value           uniform 0.00015;
    }
