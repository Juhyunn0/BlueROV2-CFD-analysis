FoamFile
{
    format      binary;
    class       volVectorField;
    location    "0";
    object      U;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

dimensions      [0 1 -1 0 0 0 0];

internalField   uniform (0 0 0);

boundaryField
{
    xmin
    {
        type            slip;
    }
    xmax
    {
        type            slip;
    }
    ymin
    {
        type            slip;
    }
    ymax
    {
        type            slip;
    }
    zmin
    {
        type            uniformFixedValue;
        uniformValue    
        {
            type            sine;
            amplitude       
            {
                type            constant;
                value           (0 0 0.2);
            }
            frequency       0.666667;
            start           0;
            level           
            {
                type            constant;
                value           (0 0 0);
            }
        }
        value           nonuniform List<vector> 
0
;
    }
    zmax
    {
        type            pressureInletOutletVelocity;
        value           nonuniform List<vector> 
0
;
    }
    BROV2
    {
        type            noSlip;
    }
    procBoundary0to1
    {
        type            processor;
        value           uniform (0 0 0);
    }
    procBoundary0to2
    {
        type            processor;
        value           uniform (0 0 0);
    }
    procBoundary0to3
    {
        type            processor;
        value           uniform (0 0 0);
    }
    procBoundary0to4
    {
        type            processor;
        value           uniform (0 0 0);
    }
    procBoundary0to5
    {
        type            processor;
        value           uniform (0 0 0);
    }
    procBoundary0to6
    {
        type            processor;
        value           uniform (0 0 0);
    }
    procBoundary0to7
    {
        type            processor;
        value           uniform (0 0 0);
    }
}


