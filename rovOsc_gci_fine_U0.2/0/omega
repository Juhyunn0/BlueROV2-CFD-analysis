FoamFile
{
    format      ascii;
    class       volScalarField;
    object      omega;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

// omega = k^0.5/(Cmu^0.25 * l), l = 0.07*L = 0.032 m -> ~0.7 1/s
dimensions      [0 0 -1 0 0 0 0];

internalField   uniform 0.7;

boundaryField
{
    #includeEtc "caseDicts/setConstraintTypes"

    zmin
    {
        type            fixedValue;
        value           uniform 0.7;
    }

    zmax
    {
        type            inletOutlet;
        inletValue      uniform 0.7;
        value           uniform 0.7;
    }

    "(xmin|xmax|ymin|ymax)"
    {
        type            zeroGradient;
    }

    "BROV2.*"
    {
        type            omegaWallFunction;
        value           uniform 0.7;
    }
}

