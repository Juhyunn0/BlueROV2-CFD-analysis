FoamFile
{
    format      ascii;
    class       volVectorField;
    object      U;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

// Oscillating inflow: U(t) = U0 sin(2 pi t / T) along +x; U0=0.2, T=1.5 s
dimensions      [0 1 -1 0 0 0 0];

internalField   uniform (0 0 0);

boundaryField
{
    #includeEtc "caseDicts/setConstraintTypes"

    xmin
    {
        type            uniformFixedValue;
        uniformValue
        {
            type            sine;
            amplitude       (0.2 0 0);
            frequency       0.66666667;
            start           0;
            level           (0 0 0);
        }
        value           uniform (0 0 0);
    }

    xmax
    {
        type            pressureInletOutletVelocity;
        value           uniform (0 0 0);
    }

    "(ymin|ymax|zmin|zmax)"
    {
        type            slip;
    }

    "BROV2.*"
    {
        type            noSlip;
    }
}

