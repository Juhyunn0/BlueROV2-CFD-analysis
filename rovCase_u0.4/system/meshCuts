meshCuts
{
    type            surfaces;
    libs            ("libsampling.so");
    writeControl    writeTime;

    surfaceFormat   vtk;
    writeFormat     ascii;
    fields          (p);

    interpolationScheme cell;

    surfaces
    (
        yNormal
        {
            type            cutPlane;
            planeType       pointAndNormal;
            point           (0.2875 0.127 0.2286);
            normal          (0 1 0);
            interpolate     false;
        }
        xNormal
        {
            type            cutPlane;
            planeType       pointAndNormal;
            point           (0.2875 0.127 0.2286);
            normal          (1 0 0);
            interpolate     false;
        }
    );
}

