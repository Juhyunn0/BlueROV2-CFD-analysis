FoamFile
{
    format      ascii;
    class       volVectorField;
    object      U;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

// Surge inflow: 0.6 m/s along +z
dimensions      [0 1 -1 0 0 0 0];

internalField   uniform (0 0 0.2);

boundaryField
{
    #includeEtc "caseDicts/setConstraintTypes"

    inlet
    {
        type            fixedValue;
        value           uniform (0 0 0.2);
    }

    outlet
    {
        type            inletOutlet;
        inletValue      uniform (0 0 0);
        value           uniform (0 0 0.2);
    }

    "side.*"
    {
        type            symmetry;
    }

    "BROV2.*"
    {
        type            noSlip;
    }
}

