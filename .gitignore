# 폴더 구조 상관없이 모든 대용량 파일 완전 제외
**/*.stl
**/*.STL
**/*.eMesh
**/*.extendedFeatureEdgeMesh

# local Python virtualenv
bemenv/

# derived solver output: volume-field time dirs and VTK exports
# (forces.dat time series, logs, and all dicts stay tracked)
**/VTK/
**/processor*/[1-9]*/
**/processor*/[0-9]*.[0-9]*/
rovCase*/[1-9]*/
rovOsc*/[1-9]*/
rovOsc*/[0-9]*.[0-9]*/
sphereOsc*/[1-9]*/
sphereOsc*/[0-9]*.[0-9]*/

# duplicate/regenerable decomposed meshes of clone cases
# (base-case meshes rovCase/ and rovOsc/ remain tracked)
rovOsc_*/processor*/
rovCase_u*/processor*/
sphereOsc*/processor*/

# regenerable GCI-family meshes (dicts + logs stay tracked)
rovCase_gci_*/processor*/
rovCase_gci_*/constant/polyMesh/
rovOsc_gci_*/constant/polyMesh/
scripts/__pycache__/

# Claude instructions (local only)
CLAUDE.md
