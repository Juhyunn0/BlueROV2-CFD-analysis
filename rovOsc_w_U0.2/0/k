FoamFile
{
    format      ascii;
    class       volScalarField;
    object      k;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

dimensions      [0 2 -2 0 0 0 0];

internalField   uniform 1.5e-4;

boundaryField
{
    #includeEtc "caseDicts/setConstraintTypes"

    ymin
    {
        type            fixedValue;
        value           uniform 1.5e-4;
    }

    ymax
    {
        type            inletOutlet;
        inletValue      uniform 1.5e-4;
        value           uniform 1.5e-4;
    }

    "(xmin|xmax|zmin|zmax)"
    {
        type            zeroGradient;
    }

    "BROV2.*"
    {
        type            kqRWallFunction;
        value           uniform 1.5e-4;
    }
}

